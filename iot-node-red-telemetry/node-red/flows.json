        "type": "function",
        "z": "b451cca79bb0b6f0",
        "name": "Build aggregate query",
        "func": "let minutes = parseInt(msg.req.query.minutes || \"60\", 10);\nlet bucket = msg.req.query.bucket || \"1m\";\n\n// Safety limits\nif (Number.isNaN(minutes)) {\n    minutes = 60;\n}\n\nminutes = Math.max(1, Math.min(minutes, 1440));\n\n// Allow only predefined bucket sizes\nconst allowedBuckets = {\n    \"10s\": \"10 seconds\",\n    \"30s\": \"30 seconds\",\n    \"1m\": \"1 minute\",\n    \"5m\": \"5 minutes\",\n    \"15m\": \"15 minutes\",\n    \"1h\": \"1 hour\"\n};\n\nconst bucketInterval = allowedBuckets[bucket] || \"1 minute\";\n\nmsg.query = `\nSELECT\n    time_bucket($1::interval, time) AS bucket,\n    device_id,\n    COUNT(*)::int AS samples,\n    ROUND(AVG(cpu_temp_c)::numeric, 2)::float AS avg_cpu_temp_c,\n    MIN(cpu_temp_c) AS min_cpu_temp_c,\n    MAX(cpu_temp_c) AS max_cpu_temp_c,\n    ROUND(AVG(loadavg1)::numeric, 2)::float AS avg_loadavg1,\n    ROUND(AVG(memory_used_percent)::numeric, 2)::float AS avg_memory_used_percent,\n    ROUND(AVG(disk_used_percent)::numeric, 2)::float AS avg_disk_used_percent\nFROM server_metrics\nWHERE time >= NOW() - ($2::int * INTERVAL '1 minute')\nGROUP BY bucket, device_id\nORDER BY bucket DESC\nLIMIT 500;\n`;\n\nmsg.params = [bucketInterval, minutes];\n\nmsg.api_meta = {\n    requested_bucket: bucket,\n    bucket_interval: bucketInterval,\n    window_minutes: minutes\n};\n\nreturn msg;",
