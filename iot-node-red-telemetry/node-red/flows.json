    {
        "id": "f0b7df70617bf74d",
        "type": "function",
        "z": "cc8a456731dc84cf",
        "name": "Format Last Update",
        "func": "const p = msg.payload;\n\nconst formattedTimestamp = p.timestamp\n    .replace('T', ' ')\n    .split('.')[0];\n\nmsg.payload = `Device: ${p.device_id}<br>\nStatus: online<br>\nUptime: ${p.uptime_seconds} seconds<br>\nLast update: ${formattedTimestamp}`;\n\nreturn msg;",
