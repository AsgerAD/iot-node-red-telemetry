    {
        "id": "54d3536d0e2094d5",
        "type": "function",
        "z": "b451cca79bb0b6f0",
        "name": "Build moving average query",
        "func": "let minutes = parseInt(msg.req.query.minutes || \"60\", 10);\nlet windowMinutes = parseInt(msg.req.query.window || \"5\", 10);\nlet bucket = msg.req.query.bucket || \"1m\";\n\nif (Number.isNaN(minutes)) minutes = 60;\nif (Number.isNaN(windowMinutes)) windowMinutes = 5;\n\nminutes = Math.max(1, Math.min(minutes, 1440));\nwindowMinutes = Math.max(1, Math.min(windowMinutes, 120));\n\nconst allowedBuckets = {\n    \"10s\": { interval: \"10 seconds\", seconds: 10 },\n    \"30s\": { interval: \"30 seconds\", seconds: 30 },\n    \"1m\": { interval: \"1 minute\", seconds: 60 },\n    \"5m\": { interval: \"5 minutes\", seconds: 300 }\n};\n\nconst selectedBucket = allowedBuckets[bucket] || allowedBuckets[\"1m\"];\nconst bucketInterval = selectedBucket.interval;\n\n// Number of bucket rows included in the moving average window.\n// Example: 5 minute window with 1 minute buckets = 5 rows.\nconst windowRows = Math.max(1, Math.ceil((windowMinutes * 60) / selectedBucket.seconds));\n\nmsg.query = `\nWITH bucketed AS (\n    SELECT\n        time_bucket($1::interval, time) AS bucket,\n        device_id,\n        COUNT(*)::int AS samples,\n        ROUND(AVG(cpu_temp_c)::numeric, 2)::float AS avg_cpu_temp_c,\n        ROUND(AVG(loadavg1)::numeric, 2)::float AS avg_loadavg1,\n        ROUND(AVG(memory_used_percent)::numeric, 2)::float AS avg_memory_used_percent,\n        ROUND(AVG(disk_used_percent)::numeric, 2)::float AS avg_disk_used_percent\n    FROM server_metrics\n    WHERE time >= NOW() - (($2::int + $3::int) * INTERVAL '1 minute')\n    GROUP BY bucket, device_id\n),\nwith_moving_average AS (\n    SELECT\n        bucket,\n        device_id,\n        samples,\n        avg_cpu_temp_c,\n        ROUND(\n            AVG(avg_cpu_temp_c) OVER (\n                PARTITION BY device_id\n                ORDER BY bucket\n                ROWS BETWEEN ${windowRows - 1} PRECEDING AND CURRENT ROW\n            )::numeric,\n            2\n        )::float AS moving_avg_cpu_temp_c,\n\n        avg_loadavg1,\n        ROUND(\n            AVG(avg_loadavg1) OVER (\n                PARTITION BY device_id\n                ORDER BY bucket\n                ROWS BETWEEN ${windowRows - 1} PRECEDING AND CURRENT ROW\n            )::numeric,\n            2\n        )::float AS moving_avg_loadavg1,\n\n        avg_memory_used_percent,\n        ROUND(\n            AVG(avg_memory_used_percent) OVER (\n                PARTITION BY device_id\n                ORDER BY bucket\n                ROWS BETWEEN ${windowRows - 1} PRECEDING AND CURRENT ROW\n            )::numeric,\n            2\n        )::float AS moving_avg_memory_used_percent,\n\n        avg_disk_used_percent,\n        ROUND(\n            AVG(avg_disk_used_percent) OVER (\n                PARTITION BY device_id\n                ORDER BY bucket\n                ROWS BETWEEN ${windowRows - 1} PRECEDING AND CURRENT ROW\n            )::numeric,\n            2\n        )::float AS moving_avg_disk_used_percent\n    FROM bucketed\n)\nSELECT *\nFROM with_moving_average\nWHERE bucket >= NOW() - ($2::int * INTERVAL '1 minute')\nORDER BY bucket DESC\nLIMIT 500;\n`;\n\nmsg.params = [bucketInterval, minutes, windowMinutes];\n\nmsg.api_meta = {\n    endpoint: \"/api/moving-average\",\n    bucket: bucketInterval,\n    window_minutes: windowMinutes,\n    returned_minutes: minutes,\n    window_rows: windowRows\n};\n\nreturn msg;",
