    {
        "id": "34f1a44a81c2fd2f",
        "type": "function",
        "z": "cc8a456731dc84cf",
        "name": "Calculate 5 min moving average",
        "func": "const p = msg.payload;\n\nconst windowMinutes = 5;\nconst windowMs = windowMinutes * 60 * 1000;\n\nconst sampleTime = new Date(p.timestamp).getTime();\n\nlet samples = context.get(\"samples\") || [];\n\nsamples.push({\n    t: sampleTime,\n    cpu_temp_c: Number(p.cpu_temp_c),\n    loadavg1: Number(p.loadavg1),\n    memory_used_percent: Number(p.memory_used_percent),\n    disk_used_percent: Number(p.disk_used_percent)\n});\n\n// Keep only samples from the last 5 minutes\nsamples = samples.filter(s => s.t >= sampleTime - windowMs);\n\nfunction avg(values) {\n    const valid = values.filter(v => Number.isFinite(v));\n    if (valid.length === 0) return null;\n    return valid.reduce((a, b) => a + b, 0) / valid.length;\n}\n\nfunction round2(x) {\n    if (x === null) return null;\n    return Math.round(x * 100) / 100;\n}\n\nconst result = {\n    device_id: p.device_id,\n    timestamp: p.timestamp,\n    window_minutes: windowMinutes,\n    samples: samples.length,\n\n    current_cpu_temp_c: p.cpu_temp_c,\n    moving_avg_cpu_temp_c: round2(avg(samples.map(s => s.cpu_temp_c))),\n\n    current_loadavg1: p.loadavg1,\n    moving_avg_loadavg1: round2(avg(samples.map(s => s.loadavg1))),\n\n    current_memory_used_percent: p.memory_used_percent,\n    moving_avg_memory_used_percent: round2(avg(samples.map(s => s.memory_used_percent))),\n\n    current_disk_used_percent: p.disk_used_percent,\n    moving_avg_disk_used_percent: round2(avg(samples.map(s => s.disk_used_percent)))\n};\n\ncontext.set(\"samples\", samples);\n\nmsg.payload = result;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
