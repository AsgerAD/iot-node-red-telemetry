        "name": "Build summary query",
        "func": "let minutes = parseInt(msg.req.query.minutes || \"60\", 10);\n\nif (Number.isNaN(minutes)) {\n    minutes = 60;\n}\n\n// Safety limits\nminutes = Math.max(1, Math.min(minutes, 1440));\n\nmsg.query = `\nSELECT\n    device_id,\n    COUNT(*) AS samples,\n    MIN(cpu_temp_c) AS min_cpu_temp_c,\n    MAX(cpu_temp_c) AS max_cpu_temp_c,\n    AVG(cpu_temp_c) AS avg_cpu_temp_c,\n    MIN(loadavg1) AS min_loadavg1,\n    MAX(loadavg1) AS max_loadavg1,\n    AVG(loadavg1) AS avg_loadavg1,\n    AVG(memory_used_percent) AS avg_memory_used_percent,\n    AVG(disk_used_percent) AS avg_disk_used_percent\nFROM server_metrics\nWHERE time >= NOW() - ($1::int * INTERVAL '1 minute')\nGROUP BY device_id;\n`;\n\nmsg.params = [minutes];\n\nreturn msg;",
