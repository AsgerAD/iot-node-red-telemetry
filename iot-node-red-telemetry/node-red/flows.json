    {
        "id": "afd1ff0583c6f8d8",
        "type": "function",
        "z": "cc8a456731dc84cf",
        "name": "Generate Alert Status",
        "func": "const p = msg.payload;\n\nconst thresholds = {\n    cpu_temp_warning: 70,\n    cpu_temp_critical: 85,\n    loadavg_warning: 2.0,\n    memory_warning: 85,\n    disk_warning: 90\n};\n\nlet alerts = [];\nlet severity = \"OK\";\n\nif (p.cpu_temp_c >= thresholds.cpu_temp_critical) {\n    alerts.push(`CRITICAL CPU temperature: ${p.cpu_temp_c} °C`);\n    severity = \"CRITICAL\";\n} else if (p.cpu_temp_c >= thresholds.cpu_temp_warning) {\n    alerts.push(`High CPU temperature: ${p.cpu_temp_c} °C`);\n    severity = \"WARNING\";\n}\n\nif (p.loadavg1 >= thresholds.loadavg_warning) {\n    alerts.push(`High system load: ${p.loadavg1}`);\n    if (severity === \"OK\") severity = \"WARNING\";\n}\n\nif (p.memory_used_percent >= thresholds.memory_warning) {\n    alerts.push(`High memory usage: ${p.memory_used_percent} %`);\n    if (severity === \"OK\") severity = \"WARNING\";\n}\n\nif (p.disk_used_percent >= thresholds.disk_warning) {\n    alerts.push(`High disk usage: ${p.disk_used_percent} %`);\n    if (severity === \"OK\") severity = \"WARNING\";\n}\n\nmsg.alert = {\n    device_id: p.device_id,\n    timestamp: p.timestamp,\n    severity: severity,\n    alerts: alerts,\n    cpu_temp_c: p.cpu_temp_c,\n    loadavg1: p.loadavg1,\n    memory_used_percent: p.memory_used_percent,\n    disk_used_percent: p.disk_used_percent\n};\n\nif (alerts.length === 0) {\n    msg.payload = `Status: OK`;\n} else {\n    msg.payload = `${severity}: ${alerts.join(\" | \")}`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
        "wires": [
            [
                "1af852ed6f8e493f"
            ]
        ]
    },
